
### Biblioteca de mídia do MediaDashboard ###

# Ignora tudo dentro de midia por padrão
/midia/*

# Mantém as pastas padrão das categorias
!/midia/Animes/
/!midia/Desenhos/
!/midia/Séries/
!/midia/Filmes/
!/midia/Mangás/
!/midia/Livros/
!/midia/Fotos/
!/midia/Vídeos/
!/midia/Desejos/

# Mantém as pastas, mas ignora os arquivos de teste
/midia/Animes/*
!/midia/Animes/*/
/midia/Desenhos/*
!/midia/Desenhos/*/
/midia/Séries/*
!/midia/Séries/*/
/midia/Filmes/*
!/midia/Filmes/*/
/midia/Mangás/*
!/midia/Mangás/*/
/midia/Livros/*
!/midia/Livros/*/
/midia/Fotos/*
!/midia/Fotos/*/
/midia/Vídeos/*
!/midia/Vídeos/*/
/midia/Desejos/*
!/midia/Desejos/*/

# Ignora os arquivos dentro das subpastas, inclusive imagens e vídeos
/midia/**/*.*

### Arquivos gerados pelo Maven ###
/target/
/dist/